class PlainTextLogParser
ILogParser <|.. PlainTextLogParser }
package Formatting { interface ILogFormatter
class FormatterRegistry
class PlainFormatter
class JsonFormatter
class MessageOnlyFormatter
ILogFormatter <|.. PlainFormatter
ILogFormatter <|.. JsonFormatter
ILogFormatter <|.. MessageOnlyFormatter
FormatterRegistry o-- ILogFormatter }
package Sinks { interface ILogSink
interface ILogSinkFactory
interface IConsoleOutput
interface ILogFileStore
class SinkRegistry
class ConsoleSink
class RotatingFileSink
class TelegramSink
class ConsoleSinkFactory
class FileSinkFactory
class TelegramSinkFactory
class SystemConsoleOutput
class DiskLogFileStore
ILogSink <|.. ConsoleSink
ILogSink <|.. RotatingFileSink
ILogSink <|.. TelegramSink
ILogSinkFactory <|.. ConsoleSinkFactory
ILogSinkFactory <|.. FileSinkFactory
ILogSinkFactory <|.. TelegramSinkFactory
